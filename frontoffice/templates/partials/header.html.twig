{# ============================================================
   Frontoffice Header — Design 2026
   1. Slim institutional bar (navy)
   2. Institutional header (white: logo + entity + login)
   3. Sticky main nav (Home, Paga avviso, Spontaneo, Pendenze, Guida + Cart)
   ============================================================ #}

{# ── 1. Slim bar ── #}
<div class="slim-header">
  <div class="container">
    <div class="left">
      <span><span class="gov-dot"></span>{{ 'Sito ufficiale della Pubblica Amministrazione'|trans }}</span>
    </div>
    <div class="right">
      {% set fo_langs = {'it': 'Italiano', 'en': 'English', 'fr': 'Français', 'es': 'Español', 'de': 'Deutsch'} %}
      {% set fo_cur_lang = current_locale in fo_langs|keys ? current_locale : 'it' %}
      <details class="lang-menu">
        <summary>
          <span class="sr-only">{{ 'Seleziona lingua'|trans }}: </span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
          <span>{{ fo_langs[fo_cur_lang] }}</span>
          <svg class="caret" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <ul class="lang-menu-list">
          {% for code, label in fo_langs %}
            <li><a href="?lang={{ code }}" lang="{{ code }}" hreflang="{{ code }}"{% if code == fo_cur_lang %} class="active" aria-current="true"{% endif %}>{{ label }}</a></li>
          {% endfor %}
        </ul>
      </details>
    </div>
  </div>
</div>

{# ── 2. Institutional header ── #}
<header class="inst-header">
  <div class="container" style="padding-top:var(--sp-4);padding-bottom:var(--sp-4);display:flex;align-items:center;justify-content:space-between;gap:var(--sp-5);">
    <a class="inst-brand" href="/">
      {% if app_logo.type == 'img' %}
        <img src="{{ app_logo.src }}" alt="{{ app_entity.name }}" class="stemma" style="width:48px;height:auto;flex-shrink:0;" />
      {% else %}
        <svg class="stemma" style="width:48px;height:48px;flex-shrink:0;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
      {% endif %}
      <div>
        <div class="eyebrow">{{ 'Ente'|trans }}</div>
        <div class="title">{{ app_entity.name }}</div>
        {% if app_entity.suffix %}<div class="sub">{{ app_entity.suffix }}</div>{% endif %}
      </div>
    </a>

    <div class="inst-actions">
      {% if current_user %}
        {% set first = current_user.first_name|default('') %}
        {% set last  = current_user.last_name|default('') %}
        {% set display_name = current_user.subject_type|default('F') == 'G' and current_user.company_name|default('') != ''
          ? current_user.company_name
          : first ~ (last != '' ? ' ' ~ last|upper : '') %}
        {% set initials = (first|slice(0,1)) ~ (last|slice(0,1)) %}
        <div class="fo-user-menu" id="fo-user-menu">
          <button class="btn btn-outline" id="fo-user-btn" aria-haspopup="true" aria-expanded="false">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
            </svg>
            {{ display_name != '' ? display_name : current_user.email }}
          </button>
          <div class="fo-user-dropdown" id="fo-user-dropdown" aria-hidden="true">
            <a href="/pendenze">{{ 'Le mie pendenze'|trans }}</a>
            <a href="/profile">{{ 'Profilo'|trans }}</a>
            <a href="/logout" style="color:var(--ms-danger);">{{ 'Logout'|trans }}</a>
          </div>
        </div>
      {% else %}
        {% if login_enabled %}
          <a class="btn btn-ghost" href="/guida" style="display:none;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9"/><path d="M12 17v-5M12 8h.01"/>
            </svg>
            {{ 'Guida'|trans }}
          </a>
          {% if login_legal_entity_enabled|default(false) %}
            <details class="fo-login-menu">
              <summary class="btn btn-primary" style="color:#ffffff !important;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/>
                </svg>
                <span>{{ 'Accedi'|trans }}</span>
                <svg class="caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <div class="fo-login-panel">
                <div class="fo-login-panel-head">{{ 'Scegli come accedere'|trans }}</div>
                <a class="fo-login-option" href="/login">
                  <span class="fo-login-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  </span>
                  <span class="fo-login-text">
                    <span class="fo-login-title">{{ 'Accedi come cittadino'|trans }}</span>
                    <span class="fo-login-sub">{{ 'Con la tua identità SPID o CIE personale'|trans }}</span>
                  </span>
                  <svg class="fo-login-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
                <a class="fo-login-option" href="/login?subject=pg">
                  <span class="fo-login-icon fo-login-icon--pg">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="1"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01M12 6h.01M16 6h.01M8 10h.01M12 10h.01M16 10h.01M8 14h.01M12 14h.01M16 14h.01"/></svg>
                  </span>
                  <span class="fo-login-text">
                    <span class="fo-login-title">{{ 'Accedi come impresa'|trans }}</span>
                    <span class="fo-login-sub">{{ 'SPID per persone giuridiche: operi a nome dell’impresa con la sua Partita IVA'|trans }}</span>
                  </span>
                  <svg class="fo-login-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
              </div>
            </details>
          {% else %}
            <a class="btn btn-primary" href="/login" style="color:#ffffff !important;">
              {{ 'Accedi'|trans }}
            </a>
          {% endif %}
        {% endif %}
      {% endif %}
    </div>
  </div>
</header>

{# ── 3. Sticky main nav ── #}
<nav class="main-nav" aria-label="{{ 'Navigazione principale'|trans }}">
  <div class="container main-nav-container">
    <button class="nav-toggle-btn" id="nav-toggle-btn" aria-label="{{ 'Apri menu'|trans }}" aria-expanded="false" aria-controls="fo-nav-menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: block;">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <div class="nav-menu" id="fo-nav-menu">
      <a class="nav-item{{ current_path == '/' ? ' active' : '' }}" href="/">{{ 'Home'|trans }}</a>
      <a class="nav-item{{ current_path starts with '/pagamento-avviso' ? ' active' : '' }}" href="/pagamento-avviso">{{ 'Paga un avviso'|trans }}</a>
      <a class="nav-item{{ current_path starts with '/pagamento-spontaneo' ? ' active' : '' }}" href="/pagamento-spontaneo">{{ 'Pagamento spontaneo'|trans }}</a>
      {% if bollot_attivo %}
        <a class="nav-item nav-item--bollo{{ current_path starts with '/pagamento-bollo' ? ' active' : '' }}" href="/pagamento-bollo">{{ 'Marca da Bollo'|trans }}</a>
      {% endif %}
      {% if login_enabled %}
        <a class="nav-item{{ current_path starts with '/pendenze' ? ' active' : '' }}" href="/pendenze">{{ 'Le mie pendenze'|trans }}</a>
      {% endif %}
      <a class="nav-item{{ current_path starts with '/guida' ? ' active' : '' }}" href="/guida">{{ 'Guida'|trans }}</a>
    </div>

    <div class="spacer"></div>

    <a class="cart-btn" href="/carrello" aria-label="{{ 'Carrello'|trans }}">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="9" cy="20" r="1.5"/><circle cx="17" cy="20" r="1.5"/>
        <path d="M3 4h2l3 12h11l2-8H7"/>
      </svg>
      <span class="cart-btn-text">{{ 'Carrello'|trans }}</span>
      <span class="badge cart-badge"{% if cart_count|default(0) == 0 %} style="display:none;"{% endif %}>{{ cart_count|default(0) }}</span>
    </a>
  </div>
</nav>

{% if govpay_down %}
<div class="govpay-alert-banner" style="background: #fff1f2; border-bottom: 1px solid #fecdd3; padding: 12px 0; color: #9f1239; font-size: 14px; font-weight: 500;">
  <div class="container" style="display: flex; align-items: center; gap: 10px;">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0; color: #e11d48;">
      <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
    </svg>
    <span>{{ 'Attenzione: Il collegamento con il sistema di pagamento pagoPA è temporaneamente interrotto. Alcune operazioni di pagamento o download delle ricevute potrebbero non essere disponibili.'|trans }}</span>
  </div>
</div>
{% endif %}

<style>
.nav-item--bollo { color: var(--ms-gold-400, #D4AD4A) !important; font-weight: 600; }
.nav-item--bollo:hover, .nav-item--bollo.active { color: var(--ms-gold-300, #E4BD56) !important; }
.fo-user-menu { position: relative; }
.fo-user-dropdown {
  display: none; position: absolute; right: 0; top: calc(100% + 6px); min-width: 180px;
  background: #fff; border: 1px solid var(--border-1); border-radius: var(--r-md);
  box-shadow: var(--shadow-3); z-index: 50; overflow: hidden;
}
.fo-user-dropdown.open { display: block; }
.fo-user-dropdown a {
  display: block; padding: 10px 16px; font-size: 14px; color: var(--fg-1);
  text-decoration: none; font-weight: 500;
}
.fo-user-dropdown a:hover { background: var(--bg-2); }
.fo-login-menu { position: relative; }
.fo-login-menu > summary { list-style: none; cursor: pointer; }
.fo-login-menu > summary::-webkit-details-marker { display: none; }
.fo-login-menu > summary { display: inline-flex; align-items: center; gap: 8px; }
.fo-login-menu > summary .caret { transition: transform .15s ease; opacity: .85; }
.fo-login-menu[open] > summary .caret { transform: rotate(180deg); }
.fo-login-panel {
  position: absolute; right: 0; top: calc(100% + 8px); z-index: 50;
  width: min(340px, calc(100vw - 32px)); padding: 8px;
  background: var(--bg-0, #fff); border: 1px solid var(--border-1); border-radius: var(--r-md, 8px);
  box-shadow: var(--shadow-3);
}
.fo-login-panel-head {
  padding: 8px 10px 6px; font-size: var(--fs-12, .75rem); font-weight: var(--fw-semibold, 600);
  letter-spacing: .06em; text-transform: uppercase; color: var(--fg-3);
}
.fo-login-option {
  display: flex; align-items: center; gap: 12px; padding: 12px 10px;
  border-radius: var(--r-sm, 6px); color: var(--fg-1); text-decoration: none;
  transition: background-color .12s ease;
}
.fo-login-option + .fo-login-option { margin-top: 2px; }
.fo-login-option:hover, .fo-login-option:focus-visible { background: var(--bi-primary-a8, rgba(0,102,204,.08)); outline: none; }
.fo-login-option:focus-visible { box-shadow: 0 0 0 2px var(--border-focus, #06c) inset; }
.fo-login-icon {
  flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center;
  width: 40px; height: 40px; border-radius: 10px;
  background: var(--bi-primary-a8, rgba(0,102,204,.08)); color: var(--brand-primary, #06c);
}
.fo-login-icon--pg { background: var(--ms-purple-050, #F5F0FB); color: var(--brand-secondary, #4A2A6E); }
.fo-login-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.fo-login-title { font-size: var(--fs-16, 1rem); font-weight: var(--fw-semibold, 600); line-height: var(--lh-snug, 1.3); }
.fo-login-sub { font-size: var(--fs-13, .8125rem); color: var(--fg-3); line-height: var(--lh-snug, 1.3); }
.fo-login-arrow { flex-shrink: 0; color: var(--fg-3); transition: transform .12s ease, color .12s ease; }
.fo-login-option:hover .fo-login-arrow { transform: translateX(2px); color: var(--brand-primary, #06c); }
</style>
<script src="{{ asset('/assets/js/fo/header.js') }}"></script>
