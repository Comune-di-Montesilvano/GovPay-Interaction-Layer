<!doctype html>
<html lang="{{ current_locale|default('it') }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ app_entity.name }} – {{ 'Sportello pagamenti'|trans }}{% endblock %}</title>
    <link rel="icon" href="{{ app_favicon.href }}" type="{{ app_favicon.type }}">
    <link rel="stylesheet" href="{{ asset('/assets/css/tokens.css') }}">
    <link rel="stylesheet" href="{{ asset('/assets/css/fo-components.css') }}">
    <link rel="stylesheet" href="{{ asset('/assets/css/frontoffice.css') }}">
    {% block head %}{% endblock %}
  </head>
  <body>
    <a class="skip-link" href="#main">{{ 'Salta al contenuto principale'|trans }}</a>
    {% include 'partials/header.html.twig' %}
    <main id="main" tabindex="-1">
      {% block content %}{% endblock %}
    </main>
    {% include 'partials/footer.html.twig' %}
    {% include 'partials/fo-data.html.twig' %}
    <script src="{{ asset('/assets/js/app.js') }}"></script>
    <script src="{{ asset('/assets/js/fo/core.js') }}"></script>
    <script src="{{ asset('/assets/js/fo/submit-loader.js') }}"></script>
    {% block scripts %}{% endblock %}
  </body>
</html>

