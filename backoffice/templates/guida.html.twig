{% extends 'base.html.twig' %}

{% block title %}Guida - Sportello pagamenti{% endblock %}

{% block content %}
  {# Contenuto da backoffice/guida/guida.md (App\Services\GuidaRenderer): HTML grezzo già scartato in rendering. #}
  <style>
    .guida-toc { position: sticky; top: calc(var(--bo-topbar-height, 56px) + var(--bo-page-head-height, 0px) + 1rem); max-height: calc(100vh - var(--bo-topbar-height, 56px) - var(--bo-page-head-height, 0px) - 2rem); overflow-y: auto; font-size: .875rem; }
    .guida-toc a { display: block; padding: .15rem 0; color: var(--fg-2, #475569); text-decoration: none; }
    .guida-toc a:hover { color: var(--bs-primary); }
    .guida-toc .lvl-2 { font-weight: 600; margin-top: .5rem; }
    .guida-toc .lvl-3 { padding-left: .75rem; }
    .guida-body { max-width: 52rem; line-height: 1.6; }
    .guida-body h1 { font-size: 1.6rem; margin-bottom: .25rem; }
    .guida-body h2 { font-size: 1.3rem; margin-top: 2rem; padding-top: .5rem; border-top: 1px solid var(--border-1, #e2e8f0); }
    .guida-body h3 { font-size: 1.05rem; margin-top: 1.5rem; }
    .guida-body > h1:first-child { display: none; } /* titolo gia' nell'intestazione di pagina */
    .guida-body table { width: 100%; margin-bottom: 1rem; border-collapse: collapse; font-size: .9rem; }
    .guida-body th, .guida-body td { border: 1px solid var(--border-1, #e2e8f0); padding: .35rem .6rem; vertical-align: top; }
    .guida-body code { word-break: break-word; }
  </style>

  <div class="bo-page-head d-flex flex-column flex-md-row align-items-md-center justify-content-md-between gap-2 mb-4">
    <div>
      <h1 class="h4 mb-1"><i class="fas fa-circle-question me-2 text-primary" aria-hidden="true"></i>Guida operativa</h1>
      <p class="text-muted mb-0">Come usare lo sportello pagamenti: operazioni frequenti, ruoli e problemi comuni</p>
    </div>
  </div>

  {% if guida_html %}
    <div class="row g-4">
      <nav class="col-12 col-lg-3 d-none d-lg-block" aria-label="Indice della guida">
        <div class="guida-toc">
          {% for s in guida_sections %}
            <a class="lvl-{{ s.level }}" href="#{{ s.id }}">{{ s.title }}</a>
          {% endfor %}
        </div>
      </nav>
      <article class="col-12 col-lg-9">
        <div class="card shadow-sm">
          <div class="card-body guida-body">
            {{ guida_html|raw }}
          </div>
        </div>
      </article>
    </div>
  {% else %}
    <div class="alert alert-warning" role="alert">Guida non disponibile. Contatta un amministratore.</div>
  {% endif %}
{% endblock %}
