{% extends 'base.html.twig' %}
{% block content %}
<div class="container-fluid py-4">
  <h1 class="h4 mb-1"><i class="fas fa-triangle-exclamation me-2"></i>Rendicontazione — Righe in errore</h1>
  <p class="text-muted small mb-3">
    Righe GovPay in stato ERRORE (bridge GERI/DILAZIONE o fetch pendenza falliti). Il ciclo automatico le
    riprova solo se <code>data_pagamento</code> rientra in <code>rendicontazione.max_giorni_retry</code> —
    qui puoi forzare il ritentativo di una singola riga anche se fuori finestra.
  </p>

  {% for f in flash %}
    <div class="alert alert-{{ f.type == 'error' ? 'danger' : f.type }}">{{ f.text }}</div>
  {% endfor %}

  {% if righe|length == 0 %}
    <div class="alert alert-info">Nessuna riga in errore.</div>
  {% else %}
    <div class="table-responsive">
      <table class="table table-sm table-striped align-middle">
        <thead>
          <tr>
            <th>IUV</th>
            <th>ID Flusso</th>
            <th>Tipologia</th>
            <th class="text-end text-nowrap">Importo</th>
            <th>Data pagamento</th>
            <th>Nota errore</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {% for r in righe %}
            <tr>
              <td class="font-monospace small">
                {% if r.id_pendenza %}
                  <a href="/pendenze/dettaglio/{{ r.id_pendenza|url_encode }}?return={{ '/rendicontazione/errori'|url_encode }}">{{ r.iuv }}</a>
                {% else %}
                  {{ r.iuv }}
                {% endif %}
              </td>
              <td class="font-monospace small">
                {% if r.id_flusso %}
                  <a href="/pagamenti/ricerca-flussi/dettaglio/{{ r.id_flusso|url_encode }}?return={{ '/rendicontazione/errori'|url_encode }}">{{ r.id_flusso }}</a>
                {% endif %}
              </td>
              <td><span class="badge bg-light text-dark border">{{ r.descrizione_tipologia ?: r.cod_entrata }}</span></td>
              <td class="text-end text-nowrap">&euro;&nbsp;{{ r.importo|number_format(2, ',', '.') }}</td>
              <td>{{ r.data_pagamento ? r.data_pagamento|date('d-m-Y') : '' }}</td>
              <td class="small text-muted">{{ r.rendicontazione_note }}</td>
              <td class="text-nowrap">
                <form method="post" action="/rendicontazione/errori/{{ r.id }}/forza" onsubmit="return confirm('Forzare il ritentativo di questa riga adesso?');">
                  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                  <button type="submit" class="btn btn-sm btn-outline-primary">Forza</button>
                </form>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    {% set totalPages = (totale / per_page)|round(0, 'ceil') %}
    {% if totalPages > 1 %}
      <nav class="mt-3 d-flex flex-wrap gap-2 align-items-center" aria-label="Paginazione">
        <div class="small text-muted">Pagina {{ page }} di {{ totalPages }}</div>
        <div class="btn-group btn-group-sm" role="group">
          {% for p in 1..totalPages %}
            <a class="btn {{ p == page ? 'btn-primary' : 'btn-outline-primary' }}" href="?page={{ p }}">{{ p }}</a>
          {% endfor %}
        </div>
      </nav>
    {% endif %}
  {% endif %}
</div>
{% endblock %}
