{% extends 'base.html.twig' %}

{% block title %}Cron / Servizi - GovPay{% endblock %}

{% block content %}
  {# 1. Title Section #}
  <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-between gap-2 mb-4">
    <div>
      <h1 class="h4 mb-1"><i class="fas fa-clock me-2 text-primary"></i>Gestione Servizi di Integrazione</h1>
      <p class="text-muted mb-0">Servizi in background eseguiti dal container worker: attivazione, pausa, esecuzione immediata e storico (GIL Services Hub)</p>
    </div>
  </div>

  {% set is_admin = current_user.role in ['admin', 'superadmin'] %}

  {# 2. Read-only Warning for Operator Roles #}
  {% if not is_admin %}
    <div class="alert alert-info shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
      <i class="fas fa-info-circle fs-5" aria-hidden="true"></i>
      <span>Sei connesso come <strong>{{ current_user.role|upper }}</strong> (Sola Lettura). Le funzioni di attivazione, pausa e configurazione dei servizi sono riservate agli amministratori.</span>
    </div>
  {% endif %}

  {# 3. Cron & Daemon management #}
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-bottom-0 pb-0">
      <h5 class="mb-1 fw-bold text-dark"><i class="fas fa-microchip me-2 text-primary"></i>Stato dei Servizi Locali</h5>
      <p class="text-muted small mb-0">Monitoraggio dei cicli continui di allineamento e sincronizzazione dati.</p>
    </div>
    <div class="card-body">
    
      {# 3.1 Date Scan Form #}
      <form method="POST" action="/funzioni-avanzate/cron/set-scan-date" class="mb-4 p-3 border rounded bg-light">
        <input type="hidden" name="csrf_token" value="{{ job_csrf_token() }}">
        <label class="form-label small fw-semibold mb-1">
          <i class="fas fa-calendar-day me-1 text-primary"></i>Data inizio sincronizzazione flussi
        </label>
        <div class="d-flex gap-2 align-items-center">
          <input type="date" name="ragioneria_scan_da" class="form-control form-control-sm"
                 style="max-width:180px" value="{{ ragioneria_scan_da|default('') }}" {% if not is_admin %}disabled{% endif %}>
          <button type="submit" class="btn btn-primary btn-sm px-3" {% if not is_admin %}disabled{% endif %}>Salva</button>
        </div>
        <div class="text-muted small mt-1">Comune a ragioneria e TEFA. Il servizio di sincronizzazione scarica tutti i flussi da questa data in avanti.</div>
      </form>

      {# 3.2 Reset Range Form #}
      {% if is_admin %}
        <form method="POST" action="/funzioni-avanzate/cron/reset-range" class="mb-4 p-3 border rounded bg-light"
              onsubmit="return confirm('Confermi azzeramento TEFA + Ragioneria nell\'intervallo selezionato?');">
          <input type="hidden" name="csrf_token" value="{{ job_csrf_token() }}">
          <label class="form-label small fw-semibold mb-1 text-danger">
            <i class="fas fa-trash-can me-1"></i>Azzeramento tabelle TEFA + Ragioneria per intervallo date
          </label>
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <input type="date" name="reset_data_da" class="form-control form-control-sm" style="max-width:180px" required>
            <span class="small text-muted">a</span>
            <input type="date" name="reset_data_a" class="form-control form-control-sm" style="max-width:180px" required>
            <button type="submit" class="btn btn-danger btn-sm px-3">Azzera Dati</button>
          </div>
          <div class="text-muted small mt-1">Cancella i record con data_pagamento compresa tra le due date (incluse), limitato al dominio configurato.</div>
        </form>
      {% endif %}

      {# 3.3 Service cards: stato da gil_jobs (eseguiti dal container worker) #}
      <div class="row g-3 mb-4">
        {% for jobKey, job in jobs %}
        {% set st = job_status[jobKey] ?? {} %}
        {% set enabled = st.enabled ?? false %}
        {% set running = st.running ?? false %}
        <div class="col-md-6">
          <div class="card h-100 border shadow-none" id="job-card-{{ jobKey }}">
            <div class="card-body d-flex flex-column gap-2">
              <div class="d-flex align-items-center gap-2">
                <span class="text-primary fs-5"><i class="fas {{ job.icon }}"></i></span>
                <strong class="text-dark">{{ job.label }}</strong>
                <span class="ms-auto d-flex gap-1">
                  {% if running %}
                    <span class="badge bg-info text-dark px-2 py-1" title="Giro in corso nel worker"><i class="fas fa-spinner fa-spin me-1" aria-hidden="true"></i>IN ESECUZIONE</span>
                  {% endif %}
                  <span class="badge {{ enabled ? 'bg-success' : 'bg-secondary' }} px-2 py-1">
                    {{ enabled ? 'ATTIVO' : 'IN PAUSA' }}
                  </span>
                </span>
              </div>
              <p class="text-muted small mb-1">{{ job.description }}</p>
              {% set cur = running ? (st.current_run ?? null) : null %}
              {% if cur %}
                <div class="small" id="job-progress-{{ jobKey }}">
                  <div class="d-flex justify-content-between text-muted mb-1">
                    <span><i class="fas fa-person-running me-1" aria-hidden="true"></i>Giro in corso dal <strong>{{ cur.started_at|date('d/m H:i:s') }}</strong>{% if cur.manual %} (manuale){% endif %}</span>
                    <span>
                      {% if cur.total is not null %}
                        <strong>{{ cur.processed }} / {{ cur.total }}</strong> ({{ cur.percent }}%)
                      {% else %}
                        <strong>{{ cur.processed }}</strong> elaborati
                      {% endif %}
                    </span>
                  </div>
                  {% if cur.total is not null %}
                    <div class="progress" style="height:6px" role="progressbar" aria-label="Avanzamento giro {{ job.label }}" aria-valuenow="{{ cur.percent }}" aria-valuemin="0" aria-valuemax="100">
                      <div class="progress-bar bg-info" style="width: {{ cur.percent }}%"></div>
                    </div>
                  {% endif %}
                  <div class="text-muted mt-1">{{ cur.batches }} batch · ok {{ cur.ok }} · saltati {{ cur.skipped }} · errori {{ cur.errors }}{% if cur.remaining is not null %} · restanti {{ cur.remaining }}{% endif %}</div>
                </div>
              {% endif %}
              <div class="small text-muted">
                <i class="fas fa-clock-rotate-left me-1" aria-hidden="true"></i>Ultimo giro:
                {% if st.last_finished_at ?? null %}
                  <strong>{{ st.last_finished_at|date('d/m/Y H:i:s') }}</strong>
                  {% if st.last_status == 'error' %}
                    <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle">errore</span>
                  {% elseif st.last_status == 'ok' %}
                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">ok</span>
                  {% endif %}
                {% else %}
                  <span>mai</span>
                {% endif %}
                {% if enabled %}
                  <span class="ms-2"><i class="fas fa-forward me-1" aria-hidden="true"></i>Prossimo: <strong>{{ (st.next_run_at ?? null) ? st.next_run_at|date('d/m/Y H:i:s') : 'entro pochi secondi' }}</strong></span>
                {% endif %}
              </div>

              <div class="d-flex gap-2 mt-auto flex-wrap pt-2 border-top">
                {% if enabled %}
                  <button class="btn btn-danger btn-sm" onclick="jobSetEnabled('{{ jobKey }}', 0)" {% if not is_admin %}disabled title="Richiesti permessi amministrativi"{% endif %}>
                    <i class="fas fa-pause me-1" aria-hidden="true"></i>Pausa
                  </button>
                {% else %}
                  <button class="btn btn-success btn-sm" onclick="jobSetEnabled('{{ jobKey }}', 1)" {% if not is_admin %}disabled title="Richiesti permessi amministrativi"{% endif %}>
                    <i class="fas fa-play me-1" aria-hidden="true"></i>Attiva
                  </button>
                {% endif %}

                {% set massive_paused = jobKey == 'pendenze-massive' and not enabled %}
                <button class="btn btn-outline-primary btn-sm" onclick="jobRunNow('{{ jobKey }}')"
                        {% if not is_admin %}disabled title="Richiesti permessi amministrativi"
                        {% elseif massive_paused %}disabled title="Servizio in pausa: riattivarlo per elaborare le righe"
                        {% elseif running %}title="Un giro è già in corso: l'esecuzione richiesta parte al suo termine"
                        {% else %}title="Esegue subito un giro, anche se il servizio è in pausa"{% endif %}>
                  <i class="fas fa-bolt me-1" aria-hidden="true"></i>Esegui ora
                </button>

                {% if jobKey == 'ragioneria' and enabled %}
                  <button class="btn btn-outline-warning btn-sm" onclick="ragioneriaRescan()" title="Riscansiona tutti i flussi dalla data configurata" {% if not is_admin %}disabled{% endif %}>
                    <i class="fas fa-rotate me-1" aria-hidden="true"></i>Rescan tutto
                  </button>
                {% endif %}

                <button class="btn btn-outline-secondary btn-sm" onclick="showLog('{{ jobKey }}')">
                  <i class="fas fa-terminal me-1" aria-hidden="true"></i>Visualizza Log
                </button>
              </div>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>

      {# 3.4 Log panel #}
      <div id="daemon-log-panel" class="d-none mt-3">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span class="fw-bold text-dark small" id="daemon-log-label"><i class="fas fa-terminal text-primary me-2"></i>Console Log</span>
          <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-secondary" onclick="refreshLog()">
              <i class="fas fa-rotate-right me-1" aria-hidden="true"></i>Aggiorna
            </button>
            <button class="btn btn-sm btn-outline-danger" onclick="document.getElementById('daemon-log-panel').classList.add('d-none')">
              <i class="fas fa-xmark" aria-hidden="true"></i> Chiudi
            </button>
          </div>
        </div>
        <pre id="daemon-log-output" class="bg-dark text-light rounded p-3 small mb-0"
             style="max-height:400px;overflow-y:auto;white-space:pre-wrap;word-break:break-all;font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;">(nessuno storico)</pre>
      </div>

    </div>
  </div>

  {# 4. Local JS alerts helper instead of impToast if not present #}
  <div id="cron-alert-stack" style="position: fixed; bottom: 20px; right: 20px; z-index: 1050; max-width: 350px;"></div>

  <script>
  (function () {
    'use strict';

    let currentLogJob = null;

    function showNotification(message, isSuccess) {
      const container = document.getElementById('cron-alert-stack');
      if (!container) return;
      
      const alert = document.createElement('div');
      alert.className = `alert alert-${isSuccess ? 'success' : 'danger'} shadow-sm alert-dismissible fade show mb-2`;
      alert.role = 'alert';
      alert.innerHTML = `
        <div class="d-flex align-items-center gap-2">
          <i class="fas fa-${isSuccess ? 'check-circle' : 'exclamation-circle'}"></i>
          <span>${message}</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Chiudi" style="padding: 0.5rem 0.5rem; top: 5px; right: 5px;"></button>
      `;
      
      container.appendChild(alert);
      setTimeout(() => {
        alert.classList.remove('show');
        setTimeout(() => alert.remove(), 150);
      }, 3000);
    }

    const JOB_CSRF = '{{ job_csrf_token()|e('js') }}';

    async function postJson(url, body) {
      const payload = body || new URLSearchParams();
      payload.set('csrf_token', JOB_CSRF);
      const res = await fetch(url, { method: 'POST', body: payload });
      return res.json();
    }

    window.jobSetEnabled = async function (jobKey, enabled) {
      const body = new URLSearchParams();
      body.append('enabled', String(enabled));
      try {
        const json = await postJson('/funzioni-avanzate/cron/' + jobKey + '/enabled', body);
        if (json.ok) {
          showNotification(json.message || 'Stato aggiornato.', true);
          setTimeout(() => location.reload(), 1200);
        } else {
          showNotification(json.error || 'Errore aggiornamento servizio.', false);
        }
      } catch (e) {
        showNotification('Errore di rete: ' + e.message, false);
      }
    };

    window.jobRunNow = async function (jobKey) {
      try {
        const json = await postJson('/funzioni-avanzate/cron/' + jobKey + '/run');
        if (json.ok) {
          showNotification(json.message || 'Esecuzione richiesta.', true);
          setTimeout(() => location.reload(), 4000);
        } else {
          showNotification(json.error || 'Errore richiesta esecuzione.', false);
        }
      } catch (e) {
        showNotification('Errore di rete: ' + e.message, false);
      }
    };

    window.ragioneriaRescan = async function () {
      if (!confirm('Avviare una riscansione completa di tutti i flussi dalla data configurata?\nI dati esistenti non verranno cancellati.')) return;
      try {
        const json = await postJson('/funzioni-avanzate/cron/ragioneria/rescan');
        if (json.ok) {
          showNotification(json.message || 'Rescan richiesto.', true);
        } else {
          showNotification(json.error || 'Errore invio segnale rescan.', false);
        }
      } catch (e) {
        showNotification('Errore di rete: ' + e.message, false);
      }
    };

    window.showLog = async function (jobKey) {
      currentLogJob = jobKey;
      document.getElementById('daemon-log-label').innerHTML = `<i class="fas fa-terminal text-primary me-2"></i>Storico esecuzioni — <strong>${jobKey}</strong>`;
      document.getElementById('daemon-log-panel').classList.remove('d-none');
      document.getElementById('daemon-log-panel').scrollIntoView({ behavior: 'smooth', block: 'start' });
      await refreshLog();
    };

    // Pannello log aperto su un servizio: aggiornamento automatico (avanzamento del giro in corso).
    setInterval(() => {
      if (currentLogJob && !document.getElementById('daemon-log-panel').classList.contains('d-none')) {
        window.refreshLog();
      }
    }, 10000);

    window.refreshLog = async function () {
      if (!currentLogJob) return;
      try {
        const res  = await fetch('/funzioni-avanzate/cron/' + currentLogJob + '/log');
        const json = await res.json();
        const out  = document.getElementById('daemon-log-output');
        if (json.ok) {
          out.textContent = json.content || '(nessuno storico)';
          out.scrollTop   = 0;
        } else {
          out.textContent = json.error || 'Errore lettura log.';
        }
      } catch (e) {
        document.getElementById('daemon-log-output').textContent = 'Errore di rete: ' + e.message;
      }
    };
  })();
  </script>
{% endblock %}
