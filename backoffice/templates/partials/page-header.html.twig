{#
  Intestazione di pagina standard. Uso:
    {% embed 'partials/page-header.html.twig' with {icon: 'fa-search', title: 'Titolo', subtitle: '...', back_url: '/x', back_label: 'Torna a ...'} %}
      {% block actions %}<a class="btn btn-primary btn-sm" href="...">...</a>{% endblock %}
    {% endembed %}
  back_url: freccia a sinistra del titolo (pagine di dettaglio / modulo). subtitle e actions opzionali.
#}
<div class="bo-page-head d-flex flex-column flex-md-row align-items-md-center justify-content-md-between gap-2 mb-4">
  <div>
    <div class="d-flex align-items-center gap-2">
      {% if back_url is defined and back_url %}
        <a class="btn btn-outline-secondary btn-sm" href="{{ back_url }}" title="{{ back_label|default('Indietro') }}" aria-label="{{ back_label|default('Indietro') }}"><i class="fas fa-arrow-left" aria-hidden="true"></i></a>
      {% endif %}
      <h1 class="h4 mb-0"><i class="fas {{ icon }} me-2 text-primary" aria-hidden="true"></i>{{ title }}</h1>
    </div>
    {% if subtitle is defined and subtitle %}<p class="text-muted mb-0 mt-1">{{ subtitle }}</p>{% endif %}
  </div>
  <div class="d-flex flex-wrap align-items-center gap-2">{% block actions %}{% endblock %}</div>
</div>
