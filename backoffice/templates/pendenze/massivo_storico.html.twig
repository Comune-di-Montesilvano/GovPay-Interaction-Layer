{% extends 'base.html.twig' %}

{% block title %}Storico Inserimento Massivo{% endblock %}

{% block content %}
<div>
  <div class="bo-page-head d-flex flex-column flex-md-row align-items-md-center justify-content-md-between gap-2 mb-4">
    <div>
      <h1 class="h4 mb-1"><i class="fas fa-history me-2 text-primary"></i>Storico Caricamenti Massivi</h1>
      <p class="text-muted mb-0">Gestisci i batch di pendenze caricate: visualizza i dettagli, controlla l'avanzamento, metti in pausa l'elaborazione o elimina i batch</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/pendenze/massivo/inserimento" class="btn btn-outline-primary btn-sm">
        <i class="fas fa-file-upload me-1"></i>Nuovo Caricamento
      </a>
    </div>
  </div>



  <div class="row">
    <div class="col-12">
      <div class="mb-4">
        <div class="card shadow-sm">
          <div class="card-header">
            <div class="d-flex align-items-center gap-2">
              <h2 class="h6 mb-0">Lotti caricati</h2>
              <span class="badge rounded-pill text-bg-primary">{{ batch_list|length }}</span>
            </div>
          </div>
          <div>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead>
                  <tr>
                    <th>Lotto (Batch ID)</th>
                    <th>Data Creazione</th>
                    <th>Tot.</th>
                    <th>Stato Avanzamento (Righe)</th>
                    <th class="text-end">Azioni Batch</th>
                  </tr>
                </thead>
                <tbody>
                {% for b in batch_list %}
                  <tr>
                    <td>
                      <a href="/pendenze/massivo/dettaglio?batch={{ b.file_batch_id }}&from=storico" class="fw-semibold font-monospace" title="Apri le righe del lotto">{{ b.file_batch_id }}</a>
                    </td>
                    <td>{{ b.data_creazione|date('d/m/Y H:i') }}</td>
                    <td>{{ b.totale }}</td>
                    <td>
                      <div class="d-flex flex-wrap gap-1">
                        {% if b.pending > 0 %}<span class="badge bg-secondary">In Coda: {{ b.pending }}</span>{% endif %}
                        {% if b.paused > 0 %}<span class="badge bg-warning text-dark">In Pausa: {{ b.paused }}</span>{% endif %}
                        {% if b.processing > 0 %}<span class="badge bg-info">In Elab: {{ b.processing }}</span>{% endif %}
                        {% if b.success > 0 %}<span class="badge bg-success">Completate: {{ b.success }}</span>{% endif %}
                        {% if b.error > 0 %}<span class="badge bg-danger">Errori: {{ b.error }}</span>{% endif %}
                        {% if b.cancelled > 0 %}<span class="badge bg-dark">Annullate: {{ b.cancelled }}</span>{% endif %}
                      </div>
                    </td>
                    <td class="text-end">
                      <div class="d-inline-flex flex-wrap justify-content-end gap-1" role="group">
                        <a href="/pendenze/massivo/dettaglio?batch={{ b.file_batch_id }}&from=storico" class="btn btn-outline-secondary btn-sm">
                          <i class="fas fa-list me-1" aria-hidden="true"></i>Righe
                        </a>

                        {# Bottoni Pausa / Riprendi #}
                        {% if b.pending > 0 %}
                          <form method="POST" action="/pendenze/massivo/{{ b.file_batch_id }}/pausa" style="display:inline-block">
                            <input type="hidden" name="csrf_token" value="{{ job_csrf_token() }}">
                            <button class="btn btn-outline-warning btn-sm" title="Sospendi le elaborazioni del lotto in coda">
                              <i class="fas fa-pause"></i> Pausa
                            </button>
                          </form>
                        {% endif %}
                        {% if b.paused > 0 %}
                          <form method="POST" action="/pendenze/massivo/{{ b.file_batch_id }}/riprendi" style="display:inline-block">
                            <input type="hidden" name="csrf_token" value="{{ job_csrf_token() }}">
                            <button class="btn btn-outline-success btn-sm" title="Riprendi le elaborazioni (torneranno in coda)">
                              <i class="fas fa-play"></i> Riprendi
                            </button>
                          </form>
                        {% endif %}

                        {# Bottone Elimina (solo se sicuri di non aver inviato niente) #}
                        {% if b.processing == 0 and b.success == 0 and b.error == 0 %}
                          <form method="POST" action="/pendenze/massivo/{{ b.file_batch_id }}/elimina" onsubmit="return confirm('Eliminare fisicamente questo batch per ripulire la tabella?');" style="display:inline-block">
                            <input type="hidden" name="csrf_token" value="{{ job_csrf_token() }}">
                            <button class="btn btn-outline-danger btn-sm" title="Elimina intero lotto in coda">
                              <i class="fas fa-xmark"></i> Elimina
                            </button>
                          </form>
                        {% endif %}

                        {# Bottone Annulla al Nodo (solo per pendenze successfully create) #}
                        {% if b.success > 0 %}
                          <form method="POST" action="/pendenze/massivo/{{ b.file_batch_id }}/annulla" onsubmit="return confirm('ATTENZIONE: Stai per richiamare in blocco l\'annullamento al Nodo per tutte le {{ b.success }} pendenze andate a buon fine in questo lotto. Vuoi procedere?');" style="display:inline-block">
                            <input type="hidden" name="csrf_token" value="{{ job_csrf_token() }}">
                            <button class="btn btn-outline-danger btn-sm" title="Annulla le pendenze completate di questo batch">
                              <i class="fas fa-triangle-exclamation"></i> Annulla pendenze ({{ b.success }})
                            </button>
                          </form>
                        {% endif %}
                        
                      </div>
                    </td>
                  </tr>
                {% else %}
                  <tr>
                    <td colspan="5" class="text-center text-muted py-4">Nessun caricamento massivo registrato nello storico.</td>
                  </tr>
                {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
