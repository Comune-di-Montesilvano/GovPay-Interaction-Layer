{% extends 'base.html.twig' %}

{% block title %}Pendenze - Inserimento{% endblock %}

{% block content %}
  {% embed 'partials/page-header.html.twig' with {icon: 'fa-plus-circle', title: 'Nuova pendenza', subtitle: 'Inserisci manualmente una posizione debitoria singola', back_url: '/pendenze/ricerca', back_label: 'Torna alla ricerca'} %}{% endembed %}

  {% if errors is defined and errors %}
    <div class="alert alert-danger" role="alert">
      <ul class="mb-0">
        {% for e in errors %}<li>{{ e }}</li>{% endfor %}
      </ul>
    </div>
  {% endif %}

  {% if warnings is defined and warnings %}
    <div class="alert alert-warning" role="alert">
      <ul class="mb-0">
        {% for w in warnings %}<li>{{ w }}</li>{% endfor %}
      </ul>
    </div>
  {% endif %}

  <form method="post" action="/pendenze" class="card border-0 shadow-sm mb-4">
    <input type="hidden" name="return" value="/pendenze/ricerca">
    {% if id_dominio is defined and id_dominio %}
      <input type="hidden" name="idDominio" value="{{ id_dominio }}">
    {% endif %}

    {# ID A2A: deve essere preso esclusivamente dalla variabile d'ambiente (mostrato nel body per mantenere header in cima alla card) #}
    {% if not is_edit_mode and pendenza_templates is defined and pendenza_templates|length > 0 %}
    <div class="card-header">
      <div class="d-flex align-items-center gap-2">
        <label for="templateSelector" class="mb-0 text-nowrap"><i class="fas fa-magic me-1 text-primary" aria-hidden="true"></i>Parti da un modello</label>
        <select id="templateSelector" class="form-select" style="max-width:420px">
          <option value="">-- Seleziona per compilare in automatico --</option>
          {% for t in pendenza_templates %}
            <option value="{{ t.id }}"
                    data-tipo="{{ t.id_tipo_pendenza }}"
                    data-causale="{{ t.causale|e('html_attr') }}"
                    data-importo="{{ t.importo }}"
                    data-giorni-validita="{{ t.giorni_validita|default('') }}"
                    data-giorni-scadenza="{{ t.giorni_scadenza|default('') }}">
              {{ t.titolo }} ({{ t.importo|number_format(2, ',', '.') }} €)
            </option>
          {% endfor %}
        </select>
      </div>
    </div>
    {% endif %}
    <div class="card-body">
      {% if not id_a2a %}
        <div class="mb-3">
          <div class="alert alert-warning small mb-0">Variabile di ambiente <code>ID_A2A</code> non impostata: imposta <code>ID_A2A</code> in <code>.env</code> prima di creare pendenze.</div>
        </div>
      {% endif %}
      {% include 'pendenze/_form_pendenza.html.twig' with {
        old: old,
        tipologie_pendenze: tipologie_pendenze,
        pendenza_templates: pendenza_templates|default([]),
        default_anno: default_anno,
        is_edit: false
      } %}

      <div class="bo-filter-actions">
        <button type="submit" formaction="/pendenze/preview" formmethod="post" class="btn btn-primary">Anteprima</button>
        <a class="btn btn-outline-secondary" href="/pendenze/ricerca">Annulla</a>
        <button type="button" class="btn btn-link ms-auto" data-bs-toggle="collapse" data-bs-target="#apiExtra" aria-controls="apiExtra" aria-expanded="false"><span class="bo-when-closed">Mostra campi avanzati</span><span class="bo-when-open">Nascondi campi avanzati</span></button>
      </div>
    </div>
  </form>
{% endblock %}

{% block scripts %}
<script>
(function () {
  const tipSel = document.getElementById('idTipoPendenza');
  if (tipSel && typeof TomSelect !== 'undefined') {
    new TomSelect(tipSel, {
      create: false,
      sortField: { field: 'text', direction: 'asc' },
      placeholder: 'Cerca tipologia…',
    });
  }
})();
</script>
{% endblock %}