# Configura limiti di upload per Apache mod_php
# Header di sicurezza: tutti in apache/security-headers.conf (un solo punto). Un "Header set" qui
# verrebbe applicato dopo e sovrascriverebbe quelli, come succedeva con Permissions-Policy.

<IfModule mod_php.c>
  php_value upload_max_filesize 256M
  php_value post_max_size 256M
  php_value memory_limit 256M
</IfModule>
<IfModule mod_php7.c>
  php_value upload_max_filesize 256M
  php_value post_max_size 256M
  php_value memory_limit 256M
</IfModule>

RewriteEngine On

# Solo le directory consentite (assets, img, debug) vengono servite direttamente
RewriteRule ^(assets|img|debug)(/.*)?$ - [L]

# Tutto il resto passa al front controller Slim
RewriteRule ^ index.php [QSA,L]
